<?xml version="1.0" encoding="utf-8"?>
<!-- Menú principal Starlight (horizontal): hero a la izquierda, accesos en tarjetas a la derecha -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Fondo opaco propio: evita que se transparenten otras pantallas apiladas -->
    <ImageView
        android:id="@+id/sl_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/sl_galaxy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/sl_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.44" />

    <!-- HERO -->
    <LinearLayout
        android:id="@+id/sl_hero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@id/sl_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_width="@dimen/_124sdp"
                android:layout_height="@dimen/_124sdp"
                android:layout_gravity="center"
                android:background="@drawable/sl_glow" />
            <ImageView
                android:id="@+id/starlight_logo"
                android:layout_width="@dimen/_72sdp"
                android:layout_height="@dimen/_72sdp"
                android:layout_gravity="center"
                android:contentDescription="Starlight"
                android:src="@drawable/starlight_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/starlight_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-22dp"
            android:fontFamily="@font/noto_sans_bold"
            android:letterSpacing="0.3"
            android:text="STARLIGHT"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_21ssp" />

        <TextView
            android:id="@+id/sl_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:text="Bienvenido de vuelta, entrenador"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_9ssp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@drawable/sl_server_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_8sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_9sdp"
                android:text="✦"
                android:textColor="@color/starlight_accent"
                android:textSize="@dimen/_17ssp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.2"
                    android:text="SERVIDOR"
                    android:textColor="@color/starlight_accent"
                    android:textSize="@dimen/_7ssp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="starlight.sarl"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_12ssp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cobblemon · Minecraft 1.21.1"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_8ssp" />
                <TextView
                    android:id="@+id/sl_server_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="● Consultando servidor…"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ACCESOS -->
    <ScrollView
        android:id="@+id/sl_grid_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_6sdp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/sl_split"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.25"
                android:text="ACCESOS"
                android:textColor="@color/starlight_accent"
                android:textSize="@dimen/_8ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/discord_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/sl_card"
                    android:drawableStart="@drawable/ic_discord"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Discord"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/news_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/sl_card"
                    android:drawableStart="@drawable/ic_menu_news"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Web"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/custom_control_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/sl_card"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Controles"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_jar_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/sl_card"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Instalar .jar"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/share_logs_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/sl_card"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Registro"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:background="@drawable/sl_card"
                    android:drawableStart="@drawable/ic_folder"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="Carpeta"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_text" />
            </LinearLayout>

            <!-- Novedades: se rellenan desde el panel de Starlight (MainMenuFragment) -->
            <TextView
                android:id="@+id/sl_news_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.25"
                android:text="NOVEDADES"
                android:textColor="@color/starlight_accent"
                android:textSize="@dimen/_8ssp"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/sl_news_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior: se funde con la galaxia -->
    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-18dp"
        android:background="@drawable/sl_bottom_fade"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/sl_card"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndPadding="@dimen/_1sdp"
        app:drawableEndSize="@dimen/_12sdp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_36sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Editar perfil"
        android:src="@drawable/ic_edit_profile"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:drawableStart="@drawable/ic_sl_play"
        android:paddingStart="@dimen/_18sdp"
        android:paddingEnd="@dimen/_22sdp"
        android:text="@string/main_play"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@+id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mc_version_spinner" />

</androidx.constraintlayout.widget.ConstraintLayout>
