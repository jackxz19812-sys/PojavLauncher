<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de login Starlight (reusa la auth de Pojav: botones Microsoft / No-Premium) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/_70sdp"
        android:paddingVertical="@dimen/_18sdp">

        <ImageView
            android:layout_width="@dimen/_92sdp"
            android:layout_height="@dimen/_92sdp"
            android:contentDescription="Starlight"
            android:src="@drawable/starlight_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="STARLIGHT"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:letterSpacing="0.34"
            android:textSize="@dimen/_22ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:text="SERVIDOR COBBLEMON · EXPLORA EL UNIVERSO"
            android:textColor="@color/starlight_accent"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textSize="@dimen/_9ssp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22sdp"
            android:text="Iniciar sesión con Microsoft"
            android:textSize="@dimen/_12ssp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Jugar sin premium"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="starlight.sarl · No afiliado a Mojang ni Microsoft"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_8ssp" />

    </LinearLayout>
</ScrollView>
