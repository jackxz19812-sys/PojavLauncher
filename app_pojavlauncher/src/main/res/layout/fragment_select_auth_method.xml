<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de login Starlight (reusa la auth de Pojav: botones Microsoft / No-Premium) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/sl_galaxy" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/_14sdp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:layout_width="@dimen/_150sdp"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/sl_glow" />
                <ImageView
                    android:layout_width="@dimen/_86sdp"
                    android:layout_height="@dimen/_86sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Starlight"
                    android:src="@drawable/starlight_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.34"
                android:text="STARLIGHT"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_24ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.14"
                android:text="SERVIDOR COBBLEMON · EXPLORA EL UNIVERSO"
                android:textColor="@color/starlight_accent"
                android:textSize="@dimen/_8ssp" />

            <LinearLayout
                android:layout_width="@dimen/_250sdp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="vertical">

                <com.kdt.mcgui.MineButton
                    android:id="@+id/button_microsoft_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:drawableStart="@drawable/ic_sl_microsoft"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_26sdp"
                    android:text="Iniciar sesión con Microsoft" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/button_local_authentication"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableStart="@drawable/ic_sl_person"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_26sdp"
                    android:text="Jugar sin premium" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="starlight.sarl  ·  No afiliado a Mojang ni Microsoft"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_8ssp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
