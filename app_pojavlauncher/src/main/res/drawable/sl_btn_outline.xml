<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario: borde morado, fondo casi transparente -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#40C06FD0" />
            <stroke android:width="1.5dp" android:color="#E0C06FD0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#80120A1C" />
            <stroke android:width="1.5dp" android:color="#B3C06FD0" />
        </shape>
    </item>
</selector>
