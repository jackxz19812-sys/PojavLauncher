<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de acceso del menú: cristal oscuro con borde morado -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#D93A1D52" />
            <stroke android:width="1dp" android:color="#CCC06FD0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#B8120A1C" />
            <stroke android:width="1dp" android:color="#4DC06FD0" />
        </shape>
    </item>
</selector>
